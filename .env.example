# Any OpenAI-compatible API works. The assignment does NOT require OpenAI.
# Pick ONE provider below. Never commit a real .env file.

# --- Option A: Groq (free tier; OpenAI-compatible) ---
LLM_PROVIDER=groq
OPENAI_API_KEY=gsk-your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
# Or: GROQ_API_KEY=gsk-...  (also supported)

# --- Option B: xAI Grok ---
# LLM_PROVIDER=xai
# XAI_API_KEY=xai-your-key-here
# XAI_MODEL=grok-3-mini

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Without any key the system still runs (deterministic answers + full RBAC/eval).